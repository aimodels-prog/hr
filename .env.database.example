# Local PostgreSQL development values only. Copy this file to .env.database and
# replace the password before starting the database. Never commit .env.database.
VIA_HR_POSTGRES_DB=via_hr
VIA_HR_POSTGRES_USER=via_hr_app
VIA_HR_POSTGRES_PASSWORD=replace-with-a-local-only-password
VIA_HR_POSTGRES_PORT=55432

# This is read only by server-side database code and Drizzle tooling.
# Keep it unprefixed: VITE_ variables are exposed to the browser.
DATABASE_URL=postgresql://via_hr_app:replace-with-a-local-only-password@localhost:55432/via_hr
# Required only if this database intentionally contains more than one active organisation.
VIA_HR_ORGANISATION_ID=
DATABASE_POOL_SIZE=5

# Optional local ZKTeco bridge testing. Production uses a separate dedicated
# secret in .env.production; never reuse the Portal, database or storage secret.
VIA_HR_ZKTECO_INGEST_SECRET=replace-with-a-local-only-secret-of-at-least-32-characters

# Generate a 32-byte key with: openssl rand -base64 32
# Keep old key versions in the JSON object while records still use them.
VIA_HR_ACTIVE_FIELD_ENCRYPTION_KEY_ID=v1
VIA_HR_FIELD_ENCRYPTION_KEYS={"v1":"replace-with-a-base64-encoded-32-byte-key"}

# Private S3-compatible file storage. The local Compose stack provides MinIO.
VIA_HR_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
VIA_HR_OBJECT_STORAGE_REGION=us-east-1
VIA_HR_OBJECT_STORAGE_BUCKET=via-hr-files
VIA_HR_OBJECT_STORAGE_ACCESS_KEY_ID=via_hr_local
VIA_HR_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-at-least-32-random-characters
VIA_HR_OBJECT_STORAGE_FORCE_PATH_STYLE=true
VIA_HR_OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
VIA_HR_OBJECT_STORAGE_PORT=59000
VIA_HR_OBJECT_STORAGE_CONSOLE_PORT=59001
