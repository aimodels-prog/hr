# Copy to .env.production on the Contabo server, replace every placeholder and
# restrict it to the deployment user: chmod 600 .env.production

# Bind only to loopback. The host reverse proxy publishes HTTPS to the internet.
VIA_HR_APP_BIND_ADDRESS=127.0.0.1
VIA_HR_APP_PORT=8082
# Use the approved immutable release name or commit SHA. Do not use latest/local.
VIA_HR_IMAGE_TAG=replace-with-immutable-release-tag

# VIA HR System receives its own database, role and password. Do not reuse the
# credentials of another application hosted on the same server.
VIA_HR_POSTGRES_DB=via_hr
VIA_HR_POSTGRES_USER=via_hr_app
VIA_HR_POSTGRES_PASSWORD=replace-with-a-long-random-password

# The hostname is the private Compose service name, not localhost. URL-encode
# reserved characters in the password before placing it in this URL.
VIA_HR_DATABASE_URL=postgresql://via_hr_app:replace-with-a-long-random-password@postgres:5432/via_hr
# Set this to the production organisation UUID after the initial import.
VIA_HR_ORGANISATION_ID=
VIA_HR_DATABASE_POOL_SIZE=10

# VIA Portal is the only production login authority. The shared secret must be
# transferred through the approved secret channel and must never be committed.
PORTAL_SSO_ENABLED=true
PORTAL_URL=https://portal.via-int.com
PORTAL_SSO_ISSUER=via-portal
PORTAL_SSO_AUDIENCE=via-hr
PORTAL_APP_SLUG=via-hr
PORTAL_SSO_ALGORITHM=HS256
PORTAL_TOKEN_LIFETIME_SECONDS=120
PORTAL_SSO_SECRET=replace-with-a-dedicated-random-secret-of-at-least-32-bytes
ALLOWED_EMAIL_DOMAIN=via-int.com
APP_ORIGIN=https://careers.via-int.com
PORTAL_CALLBACK_URL=https://careers.via-int.com/auth/portal/callback
POST_LOGIN_URL=https://careers.via-int.com/dashboard
POST_LOGOUT_URL=https://portal.via-int.com
VIA_HR_SESSION_LIFETIME_SECONDS=28800
# VIA HR has no normal password login. Any future recovery mechanism must be
# separately designed, audited and explicitly enabled; it is off by default.
VIA_HR_ALLOW_PASSWORD_LOGIN=false

# Attendance punches require both server-side office geofencing and a request
# received through an approved office network. The reverse proxy must replace,
# not append user-supplied X-Forwarded-For values before VIA_HR_TRUST_PROXY is enabled.
VIA_HR_ATTENDANCE_NETWORK_ENFORCEMENT=true
VIA_HR_TRUST_PROXY=true

# Application-layer encryption for passport, national ID, salary and bank data.
# Generate the value with `openssl rand -base64 32`; never reuse the DB password.
VIA_HR_ACTIVE_FIELD_ENCRYPTION_KEY_ID=v1
VIA_HR_FIELD_ENCRYPTION_KEYS={"v1":"replace-with-a-base64-encoded-32-byte-key"}

# Private MinIO credentials used only inside VIA HR's backend network.
VIA_HR_OBJECT_STORAGE_REGION=us-east-1
VIA_HR_OBJECT_STORAGE_BUCKET=via-hr-files
VIA_HR_OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-a-random-access-key
VIA_HR_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-at-least-32-random-characters

# Upload and request controls. Production uploads fail closed if ClamAV is not
# healthy; the scanner host is supplied by Compose and is not internet-facing.
VIA_HR_MAX_FILE_BYTES=10485760
VIA_HR_MAX_REQUEST_BYTES=16777216
VIA_HR_MUTATION_RATE_LIMIT=1200
VIA_HR_READ_RATE_LIMIT=3000

# Encrypted off-server backups. Use a provider, account and bucket that are not
# hosted on this Contabo VPS. Keep previous keys until their backups expire.
VIA_HR_BACKUP_S3_ENDPOINT=https://replace-with-offsite-s3-endpoint
VIA_HR_BACKUP_S3_REGION=us-east-1
VIA_HR_BACKUP_S3_BUCKET=via-hr-offsite-backups
VIA_HR_BACKUP_S3_ACCESS_KEY_ID=replace-with-backup-only-access-key
VIA_HR_BACKUP_S3_SECRET_ACCESS_KEY=replace-with-backup-only-secret
VIA_HR_BACKUP_S3_FORCE_PATH_STYLE=false
VIA_HR_BACKUP_ACTIVE_KEY_ID=backup-v1
VIA_HR_BACKUP_KEYS={"backup-v1":"replace-with-a-different-base64-encoded-32-byte-key"}
# For an initial single-key deployment, this can be used instead of the JSON
# keyring. Move to VIA_HR_BACKUP_KEYS before rotating the key.
VIA_HR_BACKUP_KEY_BASE64=
VIA_HR_BACKUP_RETENTION_DAYS=35
